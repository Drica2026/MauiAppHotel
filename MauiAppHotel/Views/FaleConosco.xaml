<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.FaleConosco"
             Title="FaleConosco">


    <VerticalStackLayout Padding="20"
                         Spacing="8">

        <Label 
            Text="Fale Conosco"
            HorizontalTextAlignment="Center"
            FontFamily="ComicReliefbold"
            FontSize="25"
            Margin="0, 30, 0, 30" />

        <Label Text="Telefone"
               FontFamily="ComicReliefbold"
               FontSize="18"
               Margin="0, 20, 0, 5" />

            <Label Text="Tel: + 55 11 xxxx - xxxx"
                   FontSize="14"
                   HorizontalTextAlignment="Justify" />

        <Label Text="WhatsApp"
               FontFamily="ComicReliefbold"
               FontSize="18"
               Margin="0, 20, 0, 5" />

            <Label Text="55 11 9 xxxx - xxxx"
                   FontSize="14"
                   HorizontalTextAlignment="Justify" />

        <Label Text="Email"
               FontFamily="ComicReliefbold"
               FontSize="18"
               Margin="0, 20, 0, 5" />

            <Label Text="Hotelflores@hotelflores.com.br"
                   FontSize="14"
                   HorizontalTextAlignment="Justify" />

    </VerticalStackLayout>
</ContentPage>
