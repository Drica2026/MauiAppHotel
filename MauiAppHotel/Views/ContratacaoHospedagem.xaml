<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>
    </ContentPage.Resources>
    
    <VerticalStackLayout Padding="10"
                         VerticalOptions="Center">

        <Label 
            Text="Cálculo da Diária"
            FontFamily="ComicReliefbold"
            TextColor="{StaticResource Black}"
            HorizontalTextAlignment="Center"
            FontSize="30"
            Margin="0, 50, 0, 50" />

        <Border StrokeShape="RoundRectangle 10"
                BackgroundColor= "{StaticResource PrimaryDark}">
            <VerticalStackLayout Padding="10">
                <Grid ColumnDefinitions="*, *, *"
                      RowDefinitions="Auto, Auto">
                    <Label Grid.Row="0" Grid.Column="0" Text="Adultos:" FontAttributes="Bold" />
                    <Label Grid.Row="0" Grid.Column="1" 
                           Text="{Binding Value}" 
                           BindingContext="{x:Reference stp_adultos}" />

                    <Stepper x:Name="stp_adultos" Grid.Row="0" Grid.Column="2" 
                             Minimum="1" Maximum="5"/>

                    <Label Grid.Row="1" Grid.Column="0" Text="Crianças:" FontAttributes="Bold"/>
                    <Label Grid.Row="1" Grid.Column="1"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}"/>

                    <Stepper x:Name="stp_criancas" Grid.Row="1" Grid.Column="2" 
                             Minimum="0" Maximum="4"/>
                </Grid>

                <Label Text="Selecione sua acomodação: "
                       FontAttributes="Bold, Italic"
                       HorizontalTextAlignment="Center"
                       Margin="0,20, 0, 5"/>

                <Border StrokeShape="RoundRectangle 10"
                        BackgroundColor= "{StaticResource White}"
                        Margin="0, 5, 0, 15">

                    <Picker x:Name="pck_quarto" >

                        <Picker.Items>
                            <x:String>Quarto Duplo</x:String>
                            <x:String>Quarto Triplo</x:String>
                            <x:String>Quarto Quadruplo</x:String>
                            <x:String>Suíte Master</x:String>
                        </Picker.Items>
                    </Picker>
                </Border>

                <Label Text="Selecione a data da viagem: "
                       FontAttributes="Bold, Italic"
                       HorizontalTextAlignment="Center"
                       Margin="0, 20, 0, 5"/>

                <Border StrokeShape="RoundRectangle 10"
                        BackgroundColor= "{StaticResource Gray200}"
                        Margin="0, 5, 0, 15">

                    <Grid RowDefinitions="Auto, Auto"
                          ColumnDefinitions="*, *"
                          RowSpacing="10" Padding="10">

                        <Label Grid.Row="0" Grid.Column="0" Text="Data Check-in:" FontAttributes="Italic, Bold" />
                        <DatePicker x:Name="dtpck_checkin" Grid.Row="0" Grid.Column="1" BackgroundColor="White" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Data Check-out:" FontAttributes="Italic,Bold" />
                        <DatePicker x:Name="dtpck_checkout" Grid.Row="1" Grid.Column="1" BackgroundColor="White" />

                    </Grid>
                </Border>

                <Button Text="Calcular" />

                <ImageButton
                            Source="info1.png"
                            WidthRequest="30"
                            HeightRequest="35"
                            HorizontalOptions="End"
                            Margin="10"
                            Clicked="Button_Clicked" />

            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>