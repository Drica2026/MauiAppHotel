<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Informacoes"
             Title="Informacoes">

    <VerticalStackLayout Padding="40"
                         Spacing="10">


        <Button Text="Sobre o aplicativo"
                TextColor="Black"
                FontFamily="ComicReliefbold"
                FontSize="15"
                HorizontalOptions="Start"
                BackgroundColor="White"
                Clicked="Button_Clicked" />

        <Button Text="Fale Conosco"
                TextColor="Black"
                FontFamily="ComicReliefbold"
                FontSize="15"
                HorizontalOptions="Start"
                BackgroundColor="White"
                Clicked="Button_Clicked" />

        <Button Text="Localização"
                TextColor="Black"
                FontFamily="ComicReliefbold"
                FontSize="15"
                HorizontalOptions="Start"
                BackgroundColor="White"
                Clicked="Button_Clicked" />

        <Button Text="Política de cancelamento"
                TextColor="Black"
                FontFamily="ComicReliefbold"
                FontSize="15"
                HorizontalOptions="Start"
                BackgroundColor="White"
                Clicked="Button_Clicked" />

    </VerticalStackLayout>
</ContentPage>
